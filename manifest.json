{
  "manifest_version": 3,
  "name": "Rapid Lister Pro",
  "version": "3.0.0",
  "description": "Lightning-fast Facebook Marketplace bulk listing automation with auto-location & AI publish. Developed by AB Rehman Malik.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://www.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["content.js"],
      "css": [],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Rapid Lister Pro"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
